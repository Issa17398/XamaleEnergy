# ==============================================================================
# Configuration Générale de l'Observatoire Énergétique
# ==============================================================================
APP_ENV=development
LOG_LEVEL=INFO

# ==============================================================================
# Chemins de données locaux (Relatifs à la racine du projet ou absolus)
# ==============================================================================
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REJECTED_DIR=data/rejected

# ==============================================================================
# Source A — RTE éCO2mix (ODRÉ / OpenDataSoft)
# ==============================================================================
RTE_NATIONAL_CSV_URL=https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets/eco2mix-national-cons-def/exports/csv?use_labels=true
RTE_NATIONAL_API_URL=https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets/eco2mix-national-cons-def/records
RTE_REGIONAL_CSV_URL=https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets/eco2mix-regional-cons-def/exports/csv?use_labels=true

# ==============================================================================
# Source B — Registre National des Installations (Enedis / RTE / ELD - 31/12/2025)
# ==============================================================================
ENEDIS_REGISTRE_CSV_URL=https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets/registre-national-installation-production-stockage-electricite-agrege-311225/exports/csv?use_labels=true

# ==============================================================================
# Source C — Banque Mondiale
# ==============================================================================
WORLDBANK_API_URL=https://api.worldbank.org/v2/country/FRA/indicator/EG.ELC.ACCS.ZS?format=json&per_page=1000

# ==============================================================================
# Paramètres réseau & Ingestion résiliente
# ==============================================================================
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=3
HTTP_CHUNK_SIZE_BYTES=1048576

# ==============================================================================
# Base de Données (Phase 7 - Stockage PostgreSQL)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=energy_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
